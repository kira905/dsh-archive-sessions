# dsh-archive-sessions — cordis patch 片段（示例 / 模板）
#
# 用法：把下面这一段追加到你所用 profile 的 cordis.patch.yml 末尾
#       （profile 目录：<DSH_HOME>/profiles/<name>/cordis.patch.yml）。
#
# ⚠️ 为什么必须走 patch 的 insert，而不能放进 profile package.json 的 dsh.profile.bundles：
#    本插件带 client 半（package.json 里声明了 dsh.client 而没有声明 dsh.bundle），
#    把它塞进 bundles 会让 DSH 启动即崩，报 "declares no dsh.bundle"。
#    client 插件一律走 patch insert（或在 profile 未受 bundles 管理时直接靠依赖解析加载）。
#
# ⚠️ insert 前先确认 id 不与已有条目重复（重复会崩 "duplicate loader entry id"）：
#    grep -n "id:" <DSH_HOME>/profiles/<name>/cordis.patch.yml
#
# config 段是可选的：不写就用 lib/config.js 的默认值 + <DSH_HOME>/archive-sessions.config.json。
# 这里的键会作为插件起始 config 传给 apply(ctx)，等价于「配置文件的一层前置默认值」。

- insert:
    - id: dsh-archive-sessions
      name: 'dsh-archive-sessions'
      # config:
      #   language: zh
      #   archive:
      #     manifestFile: manifest.json
      #   preview:
      #     maxMessages: 50
      #   auto:
      #     enabled: false
      #     dryRun: true
      #     hours: 48
